{
  "name": "@noflo/image",
  "description": "Image processing utilities for NoFlo",
  "version": "2.0.0-alpha.1",
  "author": {
    "name": "Forrest Oliphant",
    "email": "forrest@sembiki.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo-image.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/canvas": "^2.0.0-alpha.2",
    "@noflo/noflo": "^2.0.0-alpha.3",
    "culori": "^4.0.2",
    "file-type": "^21.0.0",
    "gifuct-js": "^2.1.2",
    "image-q": "^4.0.0",
    "image-size": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.3",
    "@noflo/loader-node": "^2.0.0-alpha.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "noflo"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ lib/ spec/ test/ typings/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ lib/ spec/ test/ typings/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec && npm run test:node",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "components/",
    "lib/",
    "spec/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
