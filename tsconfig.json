{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@noflo/canvas/engine": [
        "./typings/canvas-engine.d.ts"
      ]
    }
  },
  "include": [
    "components/",
    "lib/",
    "test/",
    "typings/"
  ],
  "exclude": [
    "lib/vendor/jsfeat.js"
  ]
}
